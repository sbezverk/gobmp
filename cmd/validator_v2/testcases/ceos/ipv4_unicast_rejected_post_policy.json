{
  "schema_version": 1,
  "name": "ipv4-unicast-rejected-post-policy",
  "description": "A route denied by the inbound route map is reported as a withdraw in post-policy monitoring.",
  "tags": ["ipv4", "unicast", "withdraw", "post-policy", "policy-rejected", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-rejected-post-policy-001",
      "nlri": {
        "prefix": "192.0.2.96/27"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498] }
      ],
      "origin": "igp",
      "med": 11,
      "communities": ["64498:11"]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "del",
      "prefix": "192.0.2.96",
      "prefix_len": 27,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_in_post_policy": true,
      "is_adj_rib_out": false
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_type": 0,
      "peer_asn": 64497,
      "is_ipv4": true,
      "is_nexthop_ipv4": true,
      "is_adj_rib_out_post_policy": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "path_id", "origin_as", "nexthop", "base_attrs.origin",
      "base_attrs.as_path", "base_attrs.nexthop", "base_attrs.med", "base_attrs.local_pref",
      "base_attrs.community_list"
    ]
  }
}
