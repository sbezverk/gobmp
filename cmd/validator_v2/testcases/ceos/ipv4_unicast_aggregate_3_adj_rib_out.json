{
  "schema_version": 1,
  "name": "ipv4-unicast-aggregate-3-adj-rib-out",
  "description": "Withdraw the second contributor; the aggregate advertised to the eBGP neighbor regains the AS path and drops ATOMIC_AGGREGATE.",
  "tags": ["ipv4", "unicast", "withdraw", "adj-rib-out", "aggregate", "manual-inject", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "203.0.113.96/27"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_out": true,
      "is_adj_rib_out_post_policy": true,
      "origin_as": 64498
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_type": 0,
      "peer_asn": 64497,
      "is_ipv4": true,
      "nexthop": "10.1.1.3",
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "as_path": [64496, 64497, 64498],
        "as_path_count": 3,
        "as_path_segments": [{ "type": 2, "asns": [64496, 64497, 64498] }],
        "nexthop": "10.1.1.3",
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "path_id", "base_attrs.med", "base_attrs.local_pref",
      "base_attrs.community_list", "base_attrs.ext_community_list",
      "base_attrs.large_community_list"
    ]
  }
}
