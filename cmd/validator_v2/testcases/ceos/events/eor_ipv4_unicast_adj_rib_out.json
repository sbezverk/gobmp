{
  "schema_version": 1,
  "name": "eor-ipv4-unicast-adj-rib-out",
  "description": "Validate the IPv4 unicast post-policy Adj-RIB-Out End-of-RIB sent after the BMP station restarts. The inject block withdraws an unused prefix; the sibling .eos file causes the message.",
  "tags": ["ipv4", "unicast", "end-of-rib", "adj-rib-out", "post-policy", "event"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "192.0.2.254/32"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.end_of_rib",
    "timeout": "120",
    "match": {
      "peer_ip": "10.1.1.20",
      "afi": 1,
      "safi": 1,
      "is_adj_rib_out": true
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "peer_rd": "0:0",
      "peer_ip": "10.1.1.20",
      "remote_bgp_id": "192.0.2.2",
      "peer_asn": 64497,
      "peer_type": 0,
      "afi": 1,
      "safi": 1,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": true,
      "is_adj_rib_out": true,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false
    },
    "present": ["timestamp"],
    "non_empty": ["router_hash", "peer_hash"],
    "absent": ["error", "action", "table_name"]
  }
}
