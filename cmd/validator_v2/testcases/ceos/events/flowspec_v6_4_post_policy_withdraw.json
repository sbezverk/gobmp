{
  "schema_version": 1,
  "name": "flowspec-v6-4-post-policy-withdraw",
  "description": "Withdraw the IPv6 FlowSpec rule (destination 2001:db8:200::/48, source 2001:db8:300::/48, redirect to 64498:100) from gobgp-flowspec and validate the post-policy record. The inject block withdraws an unused prefix; the sibling .gobgp file sends the rule.",
  "tags": ["flowspec", "ipv6", "withdraw", "post-policy", "event"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {"prefix": "192.0.2.254/32"}
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.flowspec_v6",
    "timeout": "120",
    "match": {
      "action": "del",
      "peer_ip": "10.1.1.22",
      "is_adj_rib_in_post_policy": true,
      "spec": [
        {"type": 1, "prefix_len": 48, "prefix": "IAENuAIA"},
        {"type": 2, "prefix_len": 48, "prefix": "IAENuAMA"}
      ]
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "peer_type": 0,
      "peer_asn": 64498,
      "is_ipv4": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false
    },
    "contains": {"base_attrs": {"is_atomic_agg": false}},
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["router_hash", "spec_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "path_id", "base_attrs.med", "base_attrs.community_list",
      "base_attrs.large_community_list", "origin_as", "base_attrs.origin", "base_attrs.as_path",
      "base_attrs.local_pref", "base_attrs.ext_community_list"
    ]
  }
}
