{
  "schema_version": 1,
  "name": "peer-neighbor-up",
  "description": "Re-enable the iBGP neighbor shut down by peer-neighbor-down and validate the Peer Up with its OPEN message capabilities.",
  "tags": ["peer", "peer-up", "ibgp", "event", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "192.0.2.254/32"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.peer",
    "timeout": "120",
    "match": {
      "action": "add",
      "remote_ip": "10.1.1.21"
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "speaker_ip": "10.1.1.3",
      "router_name": "ceos-1",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.3",
      "remote_asn": 64496,
      "remote_ip": "10.1.1.21",
      "peer_type": 0,
      "peer_rd": "0:0",
      "local_asn": 64496,
      "local_ip": "10.1.1.3",
      "local_port": 179,
      "local_bgp_id": "192.0.2.1",
      "remote_holddown": 90,
      "adv_holddown": 180,
      "is_l": false,
      "is_prepolicy": false,
      "is_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false
    },
    "contains": {
      "adv_cap": {
        "1": [
          { "capability_value": "AAEAAQ==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=1 safi=1 Unicast IPv4" },
          { "capability_value": "AAIAAQ==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=2 safi=1 Unicast IPv6" }
        ],
        "2": [{ "capability_descr": "Route Refresh Capability for BGP-4" }],
        "64": [{ "capability_value": "QSw=", "capability_descr": "Graceful Restart Capability" }],
        "65": [{ "capability_value": "AAD78A==", "capability_descr": "Support for 4-octet AS number capability" }],
        "69": [{ "capability_value": "AAEBAQACAQE=", "capability_descr": "ADD-PATH Capability" }],
        "70": [{ "capability_descr": "Enhanced Route Refresh Capability" }]
      },
      "recv_cap": {
        "1": [
          { "capability_value": "AAEAAQ==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=1 safi=1 Unicast IPv4" },
          { "capability_value": "AAIAAQ==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=2 safi=1 Unicast IPv6" },
          { "capability_value": "AAEABA==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=1 safi=4 MPLS Labels IPv4" },
          { "capability_value": "AAEAgA==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=1 safi=128 MPLS-labeled VPN IPv4" },
          { "capability_value": "AAIAgA==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=2 safi=128 MPLS-labeled VPN IPv6" },
          { "capability_value": "QAQARw==", "capability_descr": "Multiprotocol Extensions for BGP-4 : afi=16388 safi=71 BGP-LS BGP-LS" },
          { "capability_value": "AAEAVQ==" },
          { "capability_value": "AAIAVQ==" }
        ],
        "2": [{ "capability_descr": "Route Refresh Capability for BGP-4" }],
        "5": [{ "capability_value": "AAEAgAAC", "capability_descr": "Extended Next Hop Encoding" }],
        "65": [{ "capability_value": "AAD78A==", "capability_descr": "Support for 4-octet AS number capability" }]
      }
    },
    "present": ["timestamp"],
    "non_empty": ["hash", "router_hash", "router_descr", "remote_port"],
    "absent": ["error", "name", "info_data", "bmp_reason", "bmp_error_code", "bmp_error_sub_code", "error_text", "table_name"]
  }
}
