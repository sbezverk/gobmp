{
  "schema_version": 1,
  "name": "ipv6-unicast-route-eor",
  "description": "Validate the End-of-RIB marker published on the IPv6 unicast route topic after the BMP station restarts. gobmp publishes the empty MP_UNREACH_NLRI with action del.",
  "tags": ["ipv6", "unicast", "end-of-rib", "pre-policy", "event"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "192.0.2.254/32"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v6",
    "timeout": "120",
    "match": {
      "is_eor": true,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false
    }
  },
  "expect": {
    "equals": {
      "action": "del",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "is_ipv4": false,
      "is_nexthop_ipv4": false,
      "is_eor": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 2,
      "safi": 1
    },
    "present": ["timestamp"],
    "non_empty": ["router_hash", "peer_hash"],
    "absent": ["error", "hash", "prefix", "prefix_len", "nexthop", "origin_as", "path_id", "base_attrs", "table_name"]
  }
}
