{
  "schema_version": 1,
  "name": "peer-neighbor-down",
  "description": "Shut down the iBGP neighbor and validate the Peer Down. cEOS 4.35.2F sends reason 1 with the Cease/Administrative Shutdown NOTIFICATION or reason 2 with an FSM event code (RFC 7854 section 4.9), so neither is checked.",
  "tags": ["peer", "peer-down", "ibgp", "event"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "192.0.2.254/32"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.peer",
    "timeout": "120",
    "match": {
      "action": "down",
      "remote_ip": "10.1.1.21"
    }
  },
  "expect": {
    "equals": {
      "speaker_ip": "10.1.1.3",
      "router_name": "ceos-1",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.3",
      "remote_asn": 64496,
      "peer_type": 0,
      "peer_rd": "0:0",
      "is_l": false,
      "is_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false
    },
    "present": ["timestamp"],
    "non_empty": ["hash", "router_hash", "router_descr", "bmp_reason", "info_data"],
    "absent": [
      "error", "name", "local_asn", "local_ip", "local_port", "local_bgp_id", "remote_port",
      "remote_holddown", "adv_holddown", "adv_cap", "recv_cap", "bmp_error_code",
      "bmp_error_sub_code", "error_text", "table_name"
    ]
  }
}
