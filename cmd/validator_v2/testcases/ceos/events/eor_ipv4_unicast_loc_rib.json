{
  "schema_version": 1,
  "name": "eor-ipv4-unicast-loc-rib",
  "description": "Validate the IPv4 unicast Loc-RIB End-of-RIB sent after the BMP station restarts. The inject block withdraws an unused prefix; the sibling .eos file causes the message. cEOS sends no table name TLV in its Loc-RIB Peer Up (RFC 9069 section 5.2.1 expects \"global\"), so table_name is not checked.",
  "tags": ["ipv4", "unicast", "end-of-rib", "loc-rib", "event"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "192.0.2.254/32"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.end_of_rib",
    "timeout": "120",
    "match": {
      "peer_type": 3,
      "afi": 1,
      "safi": 1,
      "is_loc_rib": true
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "peer_rd": "0:0",
      "peer_ip": "0.0.0.0",
      "remote_bgp_id": "192.0.2.1",
      "peer_asn": 64496,
      "peer_type": 3,
      "afi": 1,
      "safi": 1,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": true,
      "is_loc_rib_filtered": false
    },
    "present": ["timestamp"],
    "non_empty": ["router_hash", "peer_hash"],
    "absent": ["error", "action"]
  }
}
