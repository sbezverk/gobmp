{
  "schema_version": 1,
  "name": "flowspec-v6-1-pre-policy-announce",
  "description": "Announce the IPv6 FlowSpec rule (destination 2001:db8:200::/48, source 2001:db8:300::/48, redirect to 64498:100) from gobgp-flowspec and validate the pre-policy record. The inject block withdraws an unused prefix; the sibling .gobgp file sends the rule.",
  "tags": ["flowspec", "ipv6", "announce", "pre-policy", "event"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {"prefix": "192.0.2.254/32"}
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.flowspec_v6",
    "timeout": "120",
    "match": {
      "action": "add",
      "peer_ip": "10.1.1.22",
      "is_adj_rib_in_post_policy": false,
      "spec": [
        {"type": 1, "prefix_len": 48, "prefix": "IAENuAIA"},
        {"type": 2, "prefix_len": 48, "prefix": "IAENuAMA"}
      ]
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "peer_type": 0,
      "peer_asn": 64498,
      "is_ipv4": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "origin_as": 64498
    },
    "contains": {
      "base_attrs": {
        "origin": "incomplete",
        "as_path": [64498],
        "as_path_count": 1,
        "is_atomic_agg": false,
        "ext_community_list": ["flowspec-redirect=64498:100"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["router_hash", "spec_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "path_id", "base_attrs.med", "base_attrs.community_list",
      "base_attrs.large_community_list", "base_attrs.local_pref"
    ]
  }
}
