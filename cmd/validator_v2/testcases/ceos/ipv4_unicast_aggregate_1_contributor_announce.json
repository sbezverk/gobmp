{
  "schema_version": 1,
  "name": "ipv4-unicast-aggregate-1-contributor-announce",
  "description": "Announce the first contributor of the cEOS aggregate; with one contributor the Loc-RIB aggregate keeps its AS path.",
  "tags": ["ipv4", "unicast", "announce", "loc-rib", "aggregate", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-aggregate-001",
      "nlri": {
        "prefix": "203.0.113.64/27"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498] }
      ],
      "origin": "igp",
      "med": 30
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "is_loc_rib": true,
      "origin_as": 64498
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.1",
      "peer_ip": "0.0.0.0",
      "peer_type": 3,
      "peer_asn": 64496,
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "is_ipv4": true,
      "origin_as": 64498,
      "nexthop": "0.0.0.0",
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": true,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "as_path": [64497, 64498],
        "as_path_count": 2,
        "as_path_segments": [{ "type": 2, "asns": [64497, 64498] }],
        "nexthop": "0.0.0.0",
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "path_id", "base_attrs.base_attr_hash"],
    "absent": [
      "error",
      "is_eor",
      "base_attrs.med",
      "base_attrs.local_pref",
      "base_attrs.community_list",
      "base_attrs.ext_community_list",
      "base_attrs.large_community_list"
    ]
  }
}
