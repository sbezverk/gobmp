{
  "schema_version": 1,
  "name": "vpnv6-pre-policy-announce",
  "description": "Inject a VPNv6 announcement with a type 1 RD and validate pre-policy L3VPN output.",
  "tags": ["vpnv6", "l3vpn", "announce", "pre-policy", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "vpnv6",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "vpnv6-pre-policy-announce-001",
      "nlri": {
        "labels": [
          { "value": 2000, "exp": 0, "is_bos": true }
        ],
        "rd": "192.0.2.2:200",
        "prefix": "2001:db8:200::/48"
      },
      "next_hops": ["2001:db8:10:1::20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498, 64507] }
      ],
      "origin": "igp",
      "med": 400,
      "local_pref": 250,
      "communities": ["64498:400"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64497, "local": 200 }
      ],
      "large_communities": [
        { "global_admin": 64498, "local_data_1": 80, "local_data_2": 400 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.l3vpn_v6",
    "timeout": "120",
    "match": {
      "action": "add",
      "vpn_rd": "192.0.2.2:200",
      "prefix": "2001:db8:200::",
      "prefix_len": 48,
      "is_adj_rib_in_post_policy": false
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "vpn_rd_type": 1,
      "is_ipv4": false,
      "origin_as": 64507,
      "nexthop": "2001:db8:10:1::20",
      "is_nexthop_ipv4": false,
      "labels": [2000],
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 2,
      "safi": 128
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "as_path": [64497, 64498, 64507],
        "as_path_count": 3,
        "as_path_segments": [{ "type": 2, "asns": [64497, 64498, 64507] }],
        "med": 400,
        "is_atomic_agg": false,
        "community_list": ["64498:400"],
        "ext_community_list": ["rt=64497:200"],
        "large_community_list": ["64498:80:400"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": ["error", "is_eor", "path_id", "base_attrs.nexthop", "base_attrs.local_pref"]
  }
}
