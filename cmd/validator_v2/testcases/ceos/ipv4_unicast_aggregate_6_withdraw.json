{
  "schema_version": 1,
  "name": "ipv4-unicast-aggregate-6-withdraw",
  "description": "Withdraw the last contributor; cEOS removes the aggregate from Loc-RIB.",
  "tags": ["ipv4", "unicast", "withdraw", "loc-rib", "aggregate", "manual-inject", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "203.0.113.64/27"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "del",
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "is_loc_rib": true
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.1",
      "peer_ip": "0.0.0.0",
      "peer_type": 3,
      "peer_asn": 64496,
      "is_ipv4": true,
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "path_id", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "origin_as", "nexthop", "base_attrs.origin", "base_attrs.as_path",
      "base_attrs.nexthop", "base_attrs.med", "base_attrs.local_pref"
    ]
  }
}
