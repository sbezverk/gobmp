{
  "schema_version": 1,
  "name": "ipv4-unicast-aggregate-4-adj-rib-out-atomic",
  "description": "Announce the second contributor again; the aggregate advertised to the eBGP neighbor carries ATOMIC_AGGREGATE.",
  "tags": ["ipv4", "unicast", "announce", "adj-rib-out", "aggregate", "atomic-aggregate", "manual-inject", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-aggregate-004",
      "nlri": {
        "prefix": "203.0.113.96/27"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64499] }
      ],
      "origin": "egp",
      "med": 30
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_out": true,
      "origin_as": 64497
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "is_ipv4": true,
      "origin_as": 64497,
      "nexthop": "10.1.1.3",
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": true,
      "is_adj_rib_out": true,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "egp",
        "as_path": [64496, 64497],
        "as_path_count": 2,
        "as_path_segments": [{ "type": 2, "asns": [64496, 64497] }],
        "nexthop": "10.1.1.3",
        "is_atomic_agg": true
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error",
      "is_eor",
      "path_id",
      "base_attrs.med",
      "base_attrs.local_pref",
      "base_attrs.community_list",
      "base_attrs.ext_community_list",
      "base_attrs.large_community_list"
    ]
  }
}
