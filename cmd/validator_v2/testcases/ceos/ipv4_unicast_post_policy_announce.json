{
  "schema_version": 1,
  "name": "ipv4-unicast-post-policy-announce",
  "description": "Validate post-policy Adj-RIB-In output; cEOS replaces the LOCAL_PREF received over eBGP with its default of 100.",
  "tags": ["ipv4", "unicast", "announce", "post-policy", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-post-policy-announce-001",
      "nlri": {
        "prefix": "198.51.100.128/26"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498, 64501] }
      ],
      "origin": "egp",
      "med": 110,
      "local_pref": 250,
      "communities": ["64498:110"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64498, "local": 110 }
      ],
      "large_communities": [
        { "global_admin": 64498, "local_data_1": 30, "local_data_2": 110 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "198.51.100.128",
      "prefix_len": 26,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_in_post_policy": true,
      "is_adj_rib_out": false
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_type": 0,
      "peer_asn": 64497,
      "is_ipv4": true,
      "origin_as": 64501,
      "nexthop": "10.1.1.20",
      "is_nexthop_ipv4": true,
      "is_adj_rib_out_post_policy": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "egp",
        "as_path": [64497, 64498, 64501],
        "as_path_count": 3,
        "as_path_segments": [{ "type": 2, "asns": [64497, 64498, 64501] }],
        "nexthop": "10.1.1.20",
        "med": 110,
        "local_pref": 100,
        "is_atomic_agg": false,
        "community_list": ["64498:110"],
        "ext_community_list": ["rt=64498:110"],
        "large_community_list": ["64498:30:110"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": ["error", "is_eor", "path_id"]
  }
}
