{
  "schema_version": 1,
  "name": "ipv4-unicast-loc-rib-announce",
  "description": "Validate the RFC 9069 Loc-RIB output for a best path; cEOS assigns a path ID to Loc-RIB routes.",
  "tags": ["ipv4", "unicast", "announce", "loc-rib", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-loc-rib-announce-001",
      "nlri": {
        "prefix": "198.51.100.192/26"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498, 64502] }
      ],
      "origin": "incomplete",
      "med": 120,
      "local_pref": 250,
      "communities": ["64498:120"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64498, "local": 120 }
      ],
      "large_communities": [
        { "global_admin": 64498, "local_data_1": 40, "local_data_2": 120 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "198.51.100.192",
      "prefix_len": 26,
      "is_loc_rib": true
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.1",
      "peer_ip": "0.0.0.0",
      "peer_type": 3,
      "peer_asn": 64496,
      "prefix": "198.51.100.192",
      "prefix_len": 26,
      "is_ipv4": true,
      "origin_as": 64502,
      "nexthop": "10.1.1.20",
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": true,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "incomplete",
        "as_path": [64497, 64498, 64502],
        "as_path_count": 3,
        "as_path_segments": [{ "type": 2, "asns": [64497, 64498, 64502] }],
        "nexthop": "10.1.1.20",
        "med": 120,
        "local_pref": 100,
        "is_atomic_agg": false,
        "community_list": ["64498:120"],
        "ext_community_list": ["rt=64498:120"],
        "large_community_list": ["64498:40:120"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "path_id", "base_attrs.base_attr_hash"],
    "absent": ["error", "is_eor"]
  }
}
