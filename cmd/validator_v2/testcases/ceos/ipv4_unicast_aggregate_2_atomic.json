{
  "schema_version": 1,
  "name": "ipv4-unicast-aggregate-2-atomic",
  "description": "Add a contributor with a different AS path and ORIGIN; the aggregate drops the differing ASNs, takes ORIGIN EGP and carries ATOMIC_AGGREGATE (RFC 4271 sections 5.1.6 and 9.2.2.2).",
  "tags": ["ipv4", "unicast", "announce", "loc-rib", "aggregate", "atomic-aggregate", "manual-inject", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-aggregate-002",
      "nlri": {
        "prefix": "203.0.113.96/27"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64499] }
      ],
      "origin": "egp",
      "med": 30
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "203.0.113.64",
      "prefix_len": 26,
      "is_loc_rib": true,
      "origin_as": 64497
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.1",
      "peer_ip": "0.0.0.0",
      "peer_type": 3,
      "peer_asn": 64496,
      "is_ipv4": true,
      "nexthop": "0.0.0.0",
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "egp",
        "as_path": [64497],
        "as_path_count": 1,
        "as_path_segments": [{ "type": 2, "asns": [64497] }],
        "nexthop": "0.0.0.0",
        "is_atomic_agg": true
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "path_id", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "base_attrs.med", "base_attrs.local_pref", "base_attrs.community_list",
      "base_attrs.ext_community_list", "base_attrs.large_community_list"
    ]
  }
}
