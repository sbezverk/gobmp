{
  "schema_version": 1,
  "name": "ipv6-unicast-loc-rib-withdraw",
  "description": "Withdraw the route created by ipv6-unicast-loc-rib-announce and validate the Loc-RIB withdraw.",
  "tags": ["ipv6", "unicast", "withdraw", "loc-rib", "manual-inject", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv6/unicast",
      "action": "withdraw",
      "nlri": {
        "prefix": "2001:db8:102::/48"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v6",
    "timeout": "120",
    "match": {
      "action": "del",
      "prefix": "2001:db8:102::",
      "prefix_len": 48,
      "is_loc_rib": true
    }
  },
  "expect": {
    "equals": {
      "action": "del",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.1",
      "peer_ip": "0.0.0.0",
      "peer_type": 3,
      "peer_asn": 64496,
      "prefix": "2001:db8:102::",
      "prefix_len": 48,
      "is_ipv4": false,
      "is_nexthop_ipv4": false,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": true,
      "is_loc_rib_filtered": false,
      "afi": 2,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "path_id", "base_attrs.base_attr_hash"],
    "absent": [
      "error",
      "is_eor",
      "origin_as",
      "nexthop",
      "base_attrs.origin",
      "base_attrs.as_path",
      "base_attrs.nexthop",
      "base_attrs.med",
      "base_attrs.local_pref",
      "base_attrs.community_list",
      "base_attrs.ext_community_list",
      "base_attrs.large_community_list"
    ]
  }
}
