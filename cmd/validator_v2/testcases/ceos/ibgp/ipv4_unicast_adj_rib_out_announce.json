{
  "schema_version": 1,
  "name": "ipv4-unicast-adj-rib-out-announce",
  "description": "Validate Adj-RIB-Out output toward the eBGP neighbor for a route learned over iBGP; LOCAL_PREF is removed and cEOS keeps the third-party next hop without a MED.",
  "tags": ["ipv4", "unicast", "announce", "ibgp", "adj-rib-out", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-adj-rib-out-announce-001",
      "nlri": {
        "prefix": "203.0.113.160/27"
      },
      "next_hops": ["10.1.1.21"],
      "origin": "igp",
      "med": 510,
      "local_pref": 210,
      "communities": ["64496:510"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64496, "local": 510 }
      ],
      "large_communities": [
        { "global_admin": 64496, "local_data_1": 90, "local_data_2": 510 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "203.0.113.160",
      "prefix_len": 27,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_out": true
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "prefix": "203.0.113.160",
      "prefix_len": 27,
      "is_ipv4": true,
      "origin_as": 64496,
      "nexthop": "10.1.1.21",
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": true,
      "is_adj_rib_out": true,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "as_path": [64496],
        "as_path_count": 1,
        "as_path_segments": [{ "type": 2, "asns": [64496] }],
        "nexthop": "10.1.1.21",
        "is_atomic_agg": false,
        "community_list": ["64496:510"],
        "ext_community_list": ["rt=64496:510"],
        "large_community_list": ["64496:90:510"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": ["error", "is_eor", "path_id", "base_attrs.med", "base_attrs.local_pref"]
  }
}
