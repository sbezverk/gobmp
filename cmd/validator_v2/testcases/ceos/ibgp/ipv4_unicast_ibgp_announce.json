{
  "schema_version": 1,
  "name": "ipv4-unicast-ibgp-announce",
  "description": "Inject an IPv4 route over iBGP; LOCAL_PREF is preserved and the AS path is empty.",
  "tags": ["ipv4", "unicast", "announce", "ibgp", "pre-policy", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-ibgp-announce-001",
      "nlri": {
        "prefix": "203.0.113.128/27"
      },
      "next_hops": ["10.1.1.21"],
      "origin": "igp",
      "med": 500,
      "local_pref": 200,
      "communities": ["64496:500"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64496, "local": 500 }
      ],
      "large_communities": [
        { "global_admin": 64496, "local_data_1": 90, "local_data_2": 500 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "203.0.113.128",
      "prefix_len": 27,
      "peer_ip": "10.1.1.21",
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.3",
      "peer_type": 0,
      "peer_asn": 64496,
      "is_ipv4": true,
      "nexthop": "10.1.1.21",
      "is_nexthop_ipv4": true,
      "is_adj_rib_out_post_policy": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "nexthop": "10.1.1.21",
        "med": 500,
        "local_pref": 200,
        "is_atomic_agg": false,
        "community_list": ["64496:500"],
        "ext_community_list": ["rt=64496:500"],
        "large_community_list": ["64496:90:500"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error", "is_eor", "path_id", "origin_as", "base_attrs.as_path", "base_attrs.as_path_count",
      "base_attrs.as_path_segments"
    ]
  }
}
