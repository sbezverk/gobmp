{
  "schema_version": 1,
  "name": "ipv4-unicast-announce",
  "description": "Inject an IPv4 unicast announcement through cEOS and validate gobmp pre-policy output.",
  "tags": ["ipv4", "unicast", "announce", "pre-policy", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv4-unicast-announce-001",
      "nlri": {
        "prefix": "198.51.100.0/24"
      },
      "next_hops": ["10.1.1.20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498, 64499] }
      ],
      "origin": "igp",
      "med": 100,
      "local_pref": 250,
      "communities": ["64498:100", "no-export"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64498, "local": 100 },
        { "type": "raw", "type_high": 0, "type_low": 3, "value_hex": "fbf2000000c8" }
      ],
      "large_communities": [
        { "global_admin": 64498, "local_data_1": 10, "local_data_2": 100 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v4",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "198.51.100.0",
      "prefix_len": 24,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false
    }
  },
  "expect": {
    "equals": {
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_type": 0,
      "peer_asn": 64497,
      "is_ipv4": true,
      "origin_as": 64499,
      "nexthop": "10.1.1.20",
      "is_nexthop_ipv4": true,
      "is_adj_rib_out_post_policy": false,
      "is_loc_rib_filtered": false,
      "afi": 1,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "as_path": [64497, 64498, 64499],
        "as_path_count": 3,
        "as_path_segments": [{ "type": 2, "asns": [64497, 64498, 64499] }],
        "nexthop": "10.1.1.20",
        "med": 100,
        "is_atomic_agg": false,
        "community_list": ["64498:100", "65535:65281"],
        "well_known_community_list": ["NO_EXPORT"],
        "ext_community_list": ["rt=64498:100", "ro=64498:200"],
        "large_community_list": ["64498:10:100"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": ["error", "is_eor", "path_id", "base_attrs.local_pref"]
  }
}
