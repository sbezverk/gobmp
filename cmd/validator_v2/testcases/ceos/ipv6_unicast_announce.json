{
  "schema_version": 1,
  "name": "ipv6-unicast-announce",
  "description": "Inject an IPv6 unicast announcement through cEOS and validate gobmp unicast IPv6 output.",
  "tags": ["ipv6", "unicast", "announce", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv6/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv6-unicast-announce-001",
      "nlri": {
        "prefix": "2001:db8:100::/48"
      },
      "next_hops": ["2001:db8:10:1::20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498, 64500] }
      ],
      "origin": "igp",
      "med": 200,
      "local_pref": 250,
      "communities": ["64498:200"],
      "extended_communities": [
        { "type": "route_target", "format": "two_octet_as", "asn": 64498, "local": 200 }
      ],
      "large_communities": [
        { "global_admin": 64498, "local_data_1": 20, "local_data_2": 200 }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v6",
    "timeout": "120",
    "match": {
      "action": "add",
      "prefix": "2001:db8:100::",
      "prefix_len": 48,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "prefix": "2001:db8:100::",
      "prefix_len": 48,
      "is_ipv4": false,
      "origin_as": 64500,
      "nexthop": "2001:db8:10:1::20",
      "is_nexthop_ipv4": false,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 2,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "origin": "igp",
        "as_path": [64497, 64498, 64500],
        "as_path_count": 3,
        "as_path_segments": [{ "type": 2, "asns": [64497, 64498, 64500] }],
        "med": 200,
        "is_atomic_agg": false,
        "community_list": ["64498:200"],
        "ext_community_list": ["rt=64498:200"],
        "large_community_list": ["64498:20:200"]
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": ["error", "is_eor", "path_id", "base_attrs.nexthop", "base_attrs.local_pref"]
  }
}
