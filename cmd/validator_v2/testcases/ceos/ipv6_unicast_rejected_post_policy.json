{
  "schema_version": 1,
  "name": "ipv6-unicast-rejected-post-policy",
  "description": "An IPv6 route denied by the inbound route map is reported as a withdraw in post-policy monitoring.",
  "tags": ["ipv6", "unicast", "withdraw", "post-policy", "policy-rejected", "manual-inject"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv6/unicast",
      "action": "announce",
      "source": "manual-fixture",
      "collector": "validator-v2",
      "sequence_id": "ipv6-unicast-rejected-post-policy-001",
      "nlri": {
        "prefix": "2001:db8:bad:2::/64"
      },
      "next_hops": ["2001:db8:10:1::20"],
      "as_path_segments": [
        { "type": "as_sequence", "asns": [64498] }
      ],
      "origin": "igp",
      "med": 21,
      "communities": ["64498:21"]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.unicast_prefix_v6",
    "timeout": "120",
    "match": {
      "action": "del",
      "prefix": "2001:db8:bad:2::",
      "prefix_len": 64,
      "peer_ip": "10.1.1.20",
      "is_adj_rib_in_post_policy": true,
      "is_adj_rib_out": false
    }
  },
  "expect": {
    "equals": {
      "action": "del",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "prefix": "2001:db8:bad:2::",
      "prefix_len": 64,
      "is_ipv4": false,
      "is_nexthop_ipv4": false,
      "is_adj_rib_in_post_policy": true,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 2,
      "safi": 1
    },
    "contains": {
      "base_attrs": {
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error",
      "is_eor",
      "path_id",
      "origin_as",
      "nexthop",
      "base_attrs.origin",
      "base_attrs.as_path",
      "base_attrs.nexthop",
      "base_attrs.med",
      "base_attrs.local_pref",
      "base_attrs.community_list"
    ]
  }
}
