{
  "schema_version": 1,
  "name": "vpnv6-pre-policy-withdraw",
  "description": "Withdraw the route created by vpnv6-pre-policy-announce.",
  "tags": ["vpnv6", "l3vpn", "withdraw", "pre-policy", "manual-inject", "requires-existing-route"],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "vpnv6",
      "action": "withdraw",
      "nlri": {
        "labels": [
          { "value": 2000, "exp": 0, "is_bos": true }
        ],
        "rd": "192.0.2.2:200",
        "prefix": "2001:db8:200::/48"
      }
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.l3vpn_v6",
    "timeout": "120",
    "match": {
      "action": "del",
      "vpn_rd": "192.0.2.2:200",
      "prefix": "2001:db8:200::",
      "prefix_len": 48,
      "is_adj_rib_in_post_policy": false
    }
  },
  "expect": {
    "equals": {
      "action": "del",
      "router_ip": "10.1.1.3",
      "remote_bgp_id": "192.0.2.2",
      "peer_ip": "10.1.1.20",
      "peer_type": 0,
      "peer_asn": 64497,
      "vpn_rd": "192.0.2.2:200",
      "vpn_rd_type": 1,
      "prefix": "2001:db8:200::",
      "prefix_len": 48,
      "is_ipv4": false,
      "is_nexthop_ipv4": false,
      "is_adj_rib_in_post_policy": false,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "afi": 2,
      "safi": 128
    },
    "contains": {
      "base_attrs": {
        "is_atomic_agg": false
      }
    },
    "present": ["timestamp", "base_attrs"],
    "non_empty": ["hash", "router_hash", "peer_hash", "base_attrs.base_attr_hash"],
    "absent": [
      "error",
      "is_eor",
      "path_id",
      "origin_as",
      "nexthop",
      "labels",
      "base_attrs.origin",
      "base_attrs.as_path",
      "base_attrs.nexthop",
      "base_attrs.med",
      "base_attrs.local_pref",
      "base_attrs.community_list",
      "base_attrs.ext_community_list",
      "base_attrs.large_community_list"
    ]
  }
}
