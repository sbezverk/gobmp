{
  "schema_version": 1,
  "name": "link-isis-attributes",
  "description": "Inject link BGP-LS NLRI and validate its decoded GoBMP Kafka event.",
  "tags": [
    "bgp-ls",
    "link",
    "announce",
    "integration"
  ],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "bgp-ls",
      "action": "announce",
      "next_hops": [
        "fd00:100::2"
      ],
      "nlri": {
        "protocol_id": "isis-level-2",
        "instance_id": "7",
        "link_state": {
          "kind": "link",
          "local_node": {
            "autonomous_system": 65000,
            "igp_router_id": {
              "kind": "isis-system-id",
              "value": "0000.0000.0001"
            }
          },
          "remote_node": {
            "autonomous_system": 65000,
            "igp_router_id": {
              "kind": "isis-system-id",
              "value": "0000.0000.0002"
            }
          },
          "link_descriptors": {
            "ipv4_interface_address": "192.0.2.1",
            "ipv4_neighbor_address": "192.0.2.2",
            "ipv6_interface_address": "2001:db8:12::1",
            "ipv6_neighbor_address": "2001:db8:12::2",
            "multi_topology_id": 7
          }
        },
        "attributes": {
          "local_ipv4_router_ids": [
            "10.0.0.1"
          ],
          "remote_ipv4_router_ids": [
            "10.0.0.2"
          ],
          "local_ipv6_router_ids": [
            "2001:db8::1"
          ],
          "remote_ipv6_router_ids": [
            "2001:db8::2"
          ],
          "administrative_group": 10,
          "maximum_link_bandwidth": 1000000000,
          "maximum_reservable_bandwidth": 900000000,
          "unreserved_bandwidth": [
            900000000,
            800000000,
            700000000,
            600000000,
            500000000,
            400000000,
            300000000,
            200000000
          ],
          "te_default_metric": 20,
          "link_protection_type": 1,
          "mpls_protocol_mask": {
            "ldp": true,
            "rsvp_te": true
          },
          "igp_metric": 10,
          "shared_risk_link_groups": [
            101,
            202
          ],
          "opaque_attributes": [
            "01020304"
          ],
          "link_name": "gobmp-isis-link",
          "msds": [
            {
              "type": 1,
              "value": 10
            }
          ],
          "extended_administrative_groups": [
            100,
            200
          ],
          "adjacency_sids": [
            {
              "flags": 176,
              "weight": 10,
              "sid_value": 16017
            },
            {
              "flags": 128,
              "weight": 20,
              "sid_value": 42
            }
          ],
          "lan_adjacency_sids": [
            {
              "flags": 176,
              "weight": 15,
              "neighbor_id": "0000.0000.0002",
              "sid_value": 16018
            }
          ],
          "peer_node_sids": [
            {
              "flags": 32,
              "weight": 10,
              "sid_value": 16019,
              "peer_as_number": 65001,
              "peer_bgp_identifier": "192.0.2.9"
            }
          ],
          "peer_adjacency_sids": [
            {
              "flags": 0,
              "weight": 20,
              "sid_value": 16020
            }
          ],
          "peer_set_sids": [
            {
              "flags": 0,
              "weight": 30,
              "sid_value": 16021
            }
          ],
          "unidirectional_link_delay": 1200,
          "min_max_unidirectional_delay": {
            "minimum": 1100,
            "maximum": 1500
          },
          "unidirectional_delay_variation": 50,
          "unidirectional_link_loss": 100,
          "unidirectional_residual_bandwidth": 750000000,
          "unidirectional_available_bandwidth": 700000000,
          "unidirectional_utilized_bandwidth": 250000000,
          "graceful_link_shutdown": true,
          "application_specific_attributes": [
            {
              "standard_application_mask": [
                0,
                0,
                0,
                1
              ],
              "user_defined_application_mask": [
                0,
                0,
                0,
                2
              ],
              "attributes": [
                {
                  "type": 1088,
                  "value_hex": "00000064"
                }
              ]
            }
          ],
          "rtm_capability": 3,
          "l2_bundle_member_attributes": [
            {
              "member_link_local_id": 77,
              "sub_tlvs": [
                {
                  "type": 1095,
                  "value_hex": "00000a"
                }
              ]
            }
          ],
          "unknown_tlvs": [
            {
              "type": 65002,
              "value_hex": "010203"
            }
          ]
        }
      },
      "origin": "igp",
      "local_pref": 100
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.ls_link",
    "timeout": "120",
    "match": {
      "action": "add",
      "domain_id": 7,
      "protocol_id": 2,
      "igp_router_id": "0000.0000.0001",
      "remote_igp_router_id": "0000.0000.0002",
      "local_link_ip": "192.0.2.1"
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "domain_id": 7,
      "protocol_id": 2,
      "igp_router_id": "0000.0000.0001",
      "remote_igp_router_id": "0000.0000.0002",
      "local_link_ip": "192.0.2.1"
    },
    "contains": {
      "remote_link_ip": "192.0.2.2",
      "router_id": "10.0.0.1",
      "remote_router_id": "10.0.0.2",
      "local_node_asn": 65000,
      "remote_node_asn": 65000,
      "mt_id_tlv": {
        "mt_id": 7
      },
      "admin_group": 10,
      "max_link_bw_kbps": 8000000,
      "max_resv_bw_kbps": 7200000,
      "unresv_bw_kbps": [
        7200000,
        6400000,
        5600000,
        4800000,
        4000000,
        3200000,
        2400000,
        1600000
      ],
      "te_default_metric": 20,
      "link_protection": 1,
      "mpls_proto_mask": 192,
      "igp_metric": 10,
      "srlg": [
        101
      ],
      "opaque_link_attribute": [
        "01020304"
      ],
      "link_name": "gobmp-isis-link",
      "link_msd": [
        {
          "msd_type": 1,
          "msd_value": 10
        }
      ],
      "ls_adjacency_sid": [
        {
          "sid": 16017,
          "weight": 10,
          "flags": {
            "f_flag": true,
            "b_flag": true,
            "v_flag": false,
            "l_flag": true,
            "s_flag": false,
            "p_flag": false
          }
        },
        {
          "sid": 42,
          "weight": 20,
          "flags": {
            "f_flag": true,
            "b_flag": false,
            "v_flag": false,
            "l_flag": false,
            "s_flag": false,
            "p_flag": false
          }
        }
      ],
      "ls_lan_adjacency_sid": [
        {
          "sid": 16018,
          "weight": 15,
          "neighbor_id": "0000.0000.0002",
          "flags": {
            "f_flag": true,
            "b_flag": true,
            "v_flag": false,
            "l_flag": true,
            "s_flag": false,
            "p_flag": false
          }
        }
      ],
      "unidir_link_delay": 1200,
      "unidir_link_delay_min_max": [
        1100,
        1500
      ],
      "unidir_delay_variation": 50,
      "unidir_packet_loss": 100,
      "unidir_residual_bw_kbps": 6000000,
      "unidir_available_bw_kbps": 5600000,
      "unidir_bw_utilization_kbps": 2000000,
      "app_spec_link_attr": [
        {
          "saibm_length": 4,
          "std_app_id_bit_mask": "AAAAAQ==",
          "ud_app_id_bit_mask": "AAAAAg==",
          "sub_tlvs": [
            {
              "sub_tlv_type": 1088,
              "sub_tlv_value": "AAAAZA=="
            }
          ]
        }
      ],
      "unknown_bgp_ls_tlvs": [
        {
          "type": 65002,
          "value_hex": "010203"
        }
      ]
    },
    "present": [
      "link_msd",
      "ls_adjacency_sid",
      "ls_lan_adjacency_sid",
      "app_spec_link_attr",
      "unidir_residual_bw_kbps",
      "unknown_bgp_ls_tlvs"
    ]
  }
}
