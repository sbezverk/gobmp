{
  "schema_version": 1,
  "name": "srv6-sid-isis-attributes",
  "description": "Inject srv6 sid BGP-LS NLRI and validate its decoded GoBMP Kafka event.",
  "tags": [
    "bgp-ls",
    "srv6-sid",
    "announce",
    "integration"
  ],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "bgp-ls",
      "action": "announce",
      "next_hops": [
        "fd00:100::2"
      ],
      "nlri": {
        "protocol_id": "isis-level-2",
        "instance_id": "7",
        "link_state": {
          "kind": "srv6_sid",
          "local_node": {
            "autonomous_system": 65000,
            "igp_router_id": {
              "kind": "isis-system-id",
              "value": "0000.0000.0007"
            }
          },
          "descriptors": {
            "sid": "2001:db8:700::1",
            "multi_topology_id": 7
          }
        },
        "attributes": {
          "endpoint_behavior": 5,
          "flags": 0,
          "algorithm": 0,
          "sid_structure": {
            "locator_block_length": 32,
            "locator_node_length": 16,
            "function_length": 16,
            "argument_length": 0
          },
          "unknown_tlvs": [
            {
              "type": 65006,
              "value_hex": "010203"
            }
          ]
        }
      },
      "origin": "igp",
      "local_pref": 100
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.ls_srv6_sid",
    "timeout": "120",
    "match": {
      "action": "add",
      "domain_id": 7,
      "protocol_id": 2,
      "srv6_sid": "2001:db8:700::1"
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "domain_id": 7,
      "protocol_id": 2,
      "srv6_sid": "2001:db8:700::1"
    },
    "contains": {
      "protocol": "IS-IS Level 2",
      "local_node_asn": 65000,
      "igp_router_id": "0000.0000.0007",
      "mt_id_tlv": {
        "mt_id": 7
      },
      "srv6_endpoint_behavior": {
        "endpoint_behavior": 5,
        "flag": 0,
        "algo": 0
      },
      "srv6_sid_structure": {
        "locator_block_length": 32,
        "locator_node_length": 16,
        "function_length": 16,
        "argument_length": 0
      }
    },
    "present": [
      "srv6_endpoint_behavior",
      "srv6_sid_structure",
      "mt_id_tlv"
    ]
  }
}
