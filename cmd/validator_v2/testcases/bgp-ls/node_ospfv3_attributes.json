{
  "schema_version": 1,
  "name": "node-ospfv3-attributes",
  "description": "Inject node BGP-LS NLRI and validate its decoded GoBMP Kafka event.",
  "tags": [
    "bgp-ls",
    "node",
    "announce",
    "integration"
  ],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "bgp-ls",
      "action": "announce",
      "next_hops": [
        "fd00:100::2"
      ],
      "nlri": {
        "protocol_id": "ospfv3",
        "instance_id": "1",
        "link_state": {
          "kind": "node",
          "local_node": {
            "autonomous_system": 65000,
            "ospf_area_id": 0,
            "igp_router_id": {
              "kind": "ospfv3-router-id",
              "value": "10.0.0.11"
            }
          }
        },
        "attributes": {
          "node_flags": {
            "abr": true,
            "router": true,
            "v6": true
          },
          "node_name": "gobmp-ospfv3-node.example.net",
          "ipv4_router_ids": [
            "10.0.0.11"
          ],
          "ipv6_router_ids": [
            "2001:db8:11::1"
          ],
          "msds": [
            {
              "type": 1,
              "value": 12
            }
          ],
          "s_bfd_discriminators": [
            2001
          ],
          "unknown_tlvs": [
            {
              "type": 65001,
              "value_hex": "aabbccdd"
            }
          ]
        }
      },
      "origin": "igp",
      "local_pref": 100
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.ls_node",
    "timeout": "120",
    "match": {
      "action": "add",
      "domain_id": 1,
      "protocol_id": 6,
      "igp_router_id": "10.0.0.11"
    }
  },
  "expect": {
    "equals": {
      "action": "add",
      "domain_id": 1,
      "protocol_id": 6,
      "igp_router_id": "10.0.0.11"
    },
    "contains": {
      "area_id": "0",
      "asn": 65000,
      "local_ipv4_router_id": "10.0.0.11",
      "local_ipv6_router_id": "2001:db8:11::1",
      "router_id": "10.0.0.11",
      "name": "gobmp-ospfv3-node.example.net",
      "node_flags": {
        "b_flag": true,
        "r_flag": true,
        "v_flag": true
      },
      "node_msd": [
        {
          "msd_type": 1,
          "msd_value": 12
        }
      ],
      "sbfd_discriminators": [
        2001
      ],
      "unknown_bgp_ls_tlvs": [
        {
          "type": 65001,
          "value_hex": "aabbccdd"
        }
      ]
    },
    "present": [
      "node_flags",
      "node_msd",
      "sbfd_discriminators",
      "unknown_bgp_ls_tlvs"
    ]
  }
}
