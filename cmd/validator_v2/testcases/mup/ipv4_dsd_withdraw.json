{
  "schema_version": 1,
  "name": "mup-ipv4-dsd-withdraw",
  "description": "Inject the ipv4/bgp-mup MUP withdraw fixture and validate the decoded AFI/SAFI 1/85 or 2/85 BMP message.",
  "tags": [
    "mup",
    "ipv4",
    "route-type-2",
    "withdraw",
    "gobgp"
  ],
  "inject": {
    "path": "/v1/routes",
    "body": {
      "address_family": "ipv4/bgp-mup",
      "action": "withdraw",
      "nlri": {
        "arch_type": 1,
        "route_type": 2,
        "route_data": {
          "rd": [
            0,
            0,
            0,
            100,
            0,
            0,
            0,
            100
          ],
          "address": [
            10,
            0,
            0,
            1
          ]
        }
      },
      "extended_communities": [
        {
          "type": "route_target",
          "format": "four_octet_as",
          "asn": 4200000000,
          "local": 100
        },
        {
          "type": "raw",
          "type_high": 12,
          "type_low": 0,
          "value_hex": "006400000064"
        }
      ]
    }
  },
  "observe": {
    "source": "kafka",
    "topic": "gobmp.parsed.mup_v4",
    "timeout": "120",
    "match": {
      "action": "del",
      "route_type": 2,
      "vpn_rd": "100:100",
      "address": "10.0.0.1"
    }
  },
  "expect": {
    "equals": {
      "action": "del",
      "router_ip": "172.30.0.2",
      "peer_ip": "172.30.0.3",
      "peer_type": 0,
      "peer_asn": 65000,
      "vpn_rd": "100:100",
      "vpn_rd_type": 0,
      "is_ipv4": true,
      "arch_type": 1,
      "route_type": 2,
      "is_nexthop_ipv4": true,
      "is_adj_rib_in_post_policy": true,
      "is_adj_rib_out_post_policy": false,
      "is_adj_rib_out": false,
      "is_loc_rib": false,
      "is_loc_rib_filtered": false,
      "address": "10.0.0.1"
    },
    "contains": {
      "base_attrs": {
        "is_atomic_agg": false
      }
    },
    "present": [
      "timestamp",
      "base_attrs"
    ],
    "non_empty": [
      "hash",
      "router_hash",
      "peer_hash",
      "base_attrs.base_attr_hash"
    ],
    "absent": [
      "error",
      "is_eor"
    ]
  }
}

